    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('getConnections').item.json.ai.groq_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: ($('getConnections').item.json.ai.groq_model || 'llama-3.3-70b-versatile'), temperature: 0.4, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: $json.system }, { role: 'user', content: $json.userMsg } ] }) }}",
        "options": {}
      },
      "id": "node-09",
      "name": "IA (Groq)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1640,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "let content = '';\ntry { content = $json.choices[0].message.content; } catch (e) { content = ''; }\nlet parsed;\ntry { parsed = JSON.parse(content); } catch (e) { parsed = { reply: content || 'Desculpe, nao consegui entender. Pode repetir?', action: null }; }\nlet action = parsed.action || null;\nif (action && (action.op === 'addTransaction' || action.op === 'createCategory' || action.op === 'createAccount') && !action.userId) {\n  const u = ($('userByPhone').item.json.user) || null;\n  if (u) action.userId = u.id;\n}\nreturn [{ json: { reply: parsed.reply || 'Ok!', action: action, hasAction: !!action } }];"
      },
      "id": "node-10",
      "name": "Parse resposta",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1860,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "h1",
              "leftValue": "={{ $json.hasAction }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "node-11",
      "name": "Tem acao?",
